# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://{db_user}:{db_password}@localhost:5432/ksiegowy_dev
POSTGRES_USER={db_user}
POSTGRES_PASSWORD={db_password}
POSTGRES_DB=ksiegowy_dev
# Host port for Docker PostgreSQL; the container port remains 5432.
POSTGRES_HOST_PORT=5432

# ─── Auth — Google OAuth2 (login) ─────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate both with: openssl rand -hex 64
JWT_SECRET=replace-with-random-value
JWT_REFRESH_SECRET=replace-with-another-random-value

# ─── File Storage ─────────────────────────────────────────────────────────────
STORAGE_BASE_PATH=./storage
# iCloud on macOS:
# STORAGE_BASE_PATH=~/Library/Mobile Documents/com~apple~CloudDocs/TrysoftInvoices

# ─── PDF Generation — Puppeteer ───────────────────────────────────────────────
# macOS: point at system Chrome to skip Chromium download (~200MB)
PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: leave unset to use Puppeteer's bundled Chromium (install via: npx puppeteer browsers install chrome)

# ─── OCR — OpenRouter ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=replace-with-openrouter-key

# ─── Google Drive Backup (optional) ───────────────────────────────────────────
# Separate OAuth app from login — scope: https://www.googleapis.com/auth/drive.file
# Authorized redirect URI: http://localhost:3001/backup/gdrive/callback
GDRIVE_CLIENT_ID=your-drive-client-id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your-drive-client-secret
GDRIVE_REDIRECT_URI=http://localhost:3001/backup/gdrive/callback
# Generate with: openssl rand -hex 32 (also used for KSeF token encryption)
ENCRYPTION_KEY=replace-with-random-value

# ─── iCloud Backup (optional) ─────────────────────────────────────────────────
# macOS: copies storage folder into iCloud Drive path; iCloud daemon auto-syncs
# Requires: nothing (uses Node.js fs + rsync which ships with macOS)
ICLOUD_BACKUP_PATH=~/Library/Mobile Documents/com~apple~CloudDocs/ksiegowy-vibe
# Linux/VPS: uses rclone (install: https://rclone.org, configure: rclone config)
ICLOUD_RCLONE_REMOTE=
ICLOUD_RCLONE_DEST=ksiegowy-vibe

# ─── PostgreSQL Backup Job (Docker Compose one-shot) ─────────────────────────
# Scheduled company Google Drive backup runs outside API process (`backup-gdrive-scheduled` one-shot).
# Optional opt-in canonical remote backup root shared by company Google Drive file
# backups and PostgreSQL remote publishing.
# PostgreSQL remote layout: <BACKUP_DESTINATION_ROOT>/postgresql/<environment>/<timestamp>/...
# Google Drive file layout: <BACKUP_DESTINATION_ROOT>/files/<environment>/company-<companyId>/...
# Leave BACKUP_DESTINATION_ROOT unset to keep legacy PostgreSQL remote destinations
# via DB_BACKUP_REMOTE_BASE_PATH. Set it to opt in to the canonical PostgreSQL path.
# BACKUP_DESTINATION_ROOT=ksiegowy-vibe-backups
DB_BACKUP_ENABLED=false
DB_BACKUP_ENVIRONMENT_NAME=local
DB_BACKUP_RETENTION_DAYS=14
DB_BACKUP_LOCAL_RETENTION_DAYS=14
DB_BACKUP_POSTGRES_READY_TIMEOUT_SECONDS=120
# Legacy PostgreSQL remote destination used only when BACKUP_DESTINATION_ROOT is unset.
# DB_BACKUP_REMOTE_BASE_PATH=ksiegowy-vibe/backups/postgresql
# Local-only mode: leave both remote names empty.
# Remote mode: configure one or two rclone remotes. Example: gdrive, icloud
# Important: database backups can contain sensitive data. Use encrypted storage
# (for example provider-side encryption and strict access controls, or rclone crypt remote).
DB_BACKUP_REMOTE_PRIMARY_NAME=
DB_BACKUP_REMOTE_SECONDARY_NAME=
# Absolute host path to rclone config file, mounted into backup container in remote mode.
# Leave empty in local-only mode.
# Example macOS: /Users/<user>/.config/rclone/rclone.conf
DB_BACKUP_RCLONE_CONFIG_PATH=
# Path used by API freshness checks to read local PostgreSQL artifacts.
# Docker API runtime overrides this to /app/backups/postgresql.
# For local API runs, ./backups/postgresql is resolved from apps/api, so an absolute
# repo path is safer. Example: /Users/maciejtrybula/Projects/ksiegowy-vibe.pl/backups/postgresql
POSTGRESQL_BACKUP_ARTIFACTS_PATH=./backups/postgresql
# Host path for local PostgreSQL backup artifacts. Used as the bind-mount source for
# backup-postgres, download-postgres-backup, restore-postgres, and verify-backups services.
# Change this to point backup and restore commands at a different directory.
DB_BACKUP_LOCAL_PATH=./backups/postgresql

# ─── Backup Freshness Check (one-shot verify-backups service) ─────────────────
BACKUP_FRESHNESS_ENABLED=true
# Requirement mode: true | false | auto (auto follows env-level enablement signals)
BACKUP_FRESHNESS_REQUIRE_POSTGRESQL_BACKUP=auto
BACKUP_FRESHNESS_REQUIRE_GDRIVE_BACKUP=auto
BACKUP_FRESHNESS_REQUIRE_ICLOUD_BACKUP=auto
# Max allowed age for latest successful/available backup evidence.
BACKUP_FRESHNESS_POSTGRESQL_MAX_AGE_HOURS=30
BACKUP_FRESHNESS_GDRIVE_MAX_AGE_HOURS=30
BACKUP_FRESHNESS_ICLOUD_MAX_AGE_HOURS=30

# ─── KSeF ─────────────────────────────────────────────────────────────────────
# Keep test as default in local/dev environments.
KSEF_ENV=test
KSEF_NIP=1234563218
KSEF_AUTH_TOKEN=replace-with-ksef-token

# ─── GUS BIR1 (NIP lookup) ────────────────────────────────────────────────────
# Get key at: https://api.stat.gov.pl/Home/RegonApi
GUS_API_KEY=

# ─── Resend (email delivery) ──────────────────────────────────────────────────
# Get key at: https://resend.com/api-keys
# Leave empty to disable email sending (POST /invoices/:id/send-email returns 501)
RESEND_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origin for browser requests (Next.js dev server)
CORS_ORIGIN=http://localhost:3000

# ─── Next.js public vars ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
