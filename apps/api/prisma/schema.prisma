generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyVatStatus {
  ACTIVE
  EXEMPT
  NO_VAT
}

enum KsefEnvironment {
  TEST
  PRODUCTION
}

enum CompanyMembershipRole {
  ADMIN
  ACCOUNTANT
  VIEWER
}

enum InvoiceStatus {
  DRAFT
  ISSUING
  ISSUED
  CANCELLED
}

enum InvoiceType {
  VAT
  KOR
  ZAL
  ROZ
  UPR
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

enum InvoiceKsefStatus {
  NOT_SENT
  QUEUED
  SUBMITTED
  ACCEPTED
  REJECTED
  OFFLINE_QUEUED
}

enum KsefSubmissionStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
  ERROR
}

enum IncomingInvoiceStatus {
  UPLOADED
  OCR_PROCESSING
  OCR_DONE
  OCR_FAILED
  CONFIRMED
  REJECTED
  KSEF_SYNCED
}

enum CompanyBackupProvider {
  GOOGLE_DRIVE
}

enum CompanyBackupScheduleMode {
  MANUAL
  DAILY
  WEEKLY
}

enum InvoiceCorrectionMode {
  CANCELLATION
  FORMAL
}

model User {
  id          String              @id @default(cuid())
  email       String              @unique
  name        String?
  googleId    String?             @unique
  avatarUrl   String?
  lastLoginAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  memberships CompanyMembership[]
}

model Company {
  id                   String                  @id @default(cuid())
  name                 String
  nip                  String                  @unique
  addressLine1         String
  addressLine2         String?
  email                String?
  phone                String?
  bankName             String?
  bankAccount          String?
  vatStatus            CompanyVatStatus        @default(ACTIVE)
  invoiceSeq           Json                    @default("{}")
  invoiceNumberPattern String?
  ksefTokenEnc         String?
  ksefTokenIv          String?
  ksefEnv              KsefEnvironment         @default(TEST)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  memberships          CompanyMembership[]
  contractors          Contractor[]
  invoices             Invoice[]
  ksefCredentials      CompanyKsefCredential[]
  ksefSessions         KsefSession[]
  submissions          KsefSubmission[]
  fileRecords          FileRecord[]
  incomingInvoices     IncomingInvoice[]
  ksefIncomingSyncs    KsefIncomingSync[]
  gDriveCredential     GoogleDriveCredential?
  backupPolicies       CompanyBackupPolicy[]
  serviceTemplates     ServiceTemplate[]
}

model CompanyKsefCredential {
  id          String          @id @default(cuid())
  companyId   String
  environment KsefEnvironment
  tokenEnc    String
  tokenIv     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, environment])
  @@index([companyId])
}

model CompanyMembership {
  id        String                @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMembershipRole @default(ADMIN)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model Contractor {
  id               String                  @id @default(cuid())
  companyId        String
  name             String
  nip              String?
  pesel            String?
  addressLine1     String?
  addressLine2     String?
  countryCode      String                  @default("PL")
  email            String?
  phone            String?
  bankAccount      String?
  notes            String?
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  incomingInvoices IncomingInvoice[]
  serviceRates     ContractorServiceRate[]

  @@unique([companyId, nip])
  @@index([companyId, name])
}

model Invoice {
  id                   String                @id @default(cuid())
  companyId            String
  environment          KsefEnvironment       @default(TEST)
  contractorId         String?
  invoiceNumber        String?
  status               InvoiceStatus         @default(DRAFT)
  issuingStartedAt     DateTime?
  invoiceType          InvoiceType           @default(VAT)
  issueDate            DateTime
  saleDate             DateTime?
  placeOfIssue         String                @default("Wrocław")
  sellerName           String?
  sellerNip            String?
  sellerAddress1       String?
  sellerAddress2       String?
  sellerEmail          String?
  sellerPhone          String?
  sellerBank           String?
  sellerAccount        String?
  buyerName            String?
  buyerNip             String?
  buyerAddress1        String?
  buyerAddress2        String?
  buyerCountry         String                @default("PL")
  totalNet             Decimal               @default(0) @db.Decimal(15, 2)
  totalVat             Decimal               @default(0) @db.Decimal(15, 2)
  totalGross           Decimal               @default(0) @db.Decimal(15, 2)
  paymentReceived      Decimal               @default(0) @db.Decimal(15, 2)
  paymentMethod        PaymentMethod         @default(BANK_TRANSFER)
  paymentDueDate       DateTime?
  currency             String                @default("PLN")
  notes                String?
  correctedInvoiceId   String?
  correctedKsefRef     String?
  correctedInvoiceNumber String?
  correctionMode       InvoiceCorrectionMode?
  correctionReason     String?
  correctionImpactType String?
  correctionRequestHash String?              @unique
  ksefReference        String?
  ksefStatus           InvoiceKsefStatus     @default(NOT_SENT)
  ksefSubmittedAt      DateTime?
  ksefAcceptedAt       DateTime?
  issuedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractor           Contractor?           @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  correctedInvoice     Invoice?              @relation("InvoiceCorrections", fields: [correctedInvoiceId], references: [id], onDelete: SetNull)
  corrections          Invoice[]             @relation("InvoiceCorrections")
  lines                InvoiceLine[]
  vatBreakdown         InvoiceVatBreakdown[]
  ksefStates           InvoiceKsefState[]
  ksefSubmissions      KsefSubmission[]
  fileRecords          FileRecord[]

  @@unique([companyId, environment, invoiceNumber])
  @@index([companyId, issueDate])
  @@index([companyId, status])
  @@index([companyId, environment, issueDate])
  @@index([companyId, environment, status])
  @@index([companyId, ksefStatus])
  @@index([contractorId])
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String
  position     Int
  name         String
  unit         String? @default("szt")
  quantity     Decimal @db.Decimal(15, 4)
  unitNetPrice Decimal @db.Decimal(15, 4)
  vatRate      String
  netValue     Decimal @db.Decimal(15, 2)
  vatValue     Decimal @db.Decimal(15, 2)
  grossValue   Decimal @db.Decimal(15, 2)
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
}

model InvoiceVatBreakdown {
  id        String  @id @default(cuid())
  invoiceId String
  vatRate   String
  netAmount Decimal @db.Decimal(15, 2)
  vatAmount Decimal @db.Decimal(15, 2)
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, vatRate])
}

model KsefSubmission {
  id                     String               @id @default(cuid())
  companyId              String
  invoiceId              String
  environment            KsefEnvironment      @default(TEST)
  attemptNumber          Int                  @default(1)
  status                 KsefSubmissionStatus
  referenceNumber        String? // v2: invoice reference number within the session
  sessionReferenceNumber String? // v2: online session reference number
  ksefReference          String?
  requestHash            String?
  responseBody           String?
  errorMessage           String?
  httpStatusCode         Int?
  externalMutationStarted Boolean            @default(false)
  submittedAt            DateTime?
  acceptedAt             DateTime?
  createdAt              DateTime             @default(now())
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice                Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceKsefStates      InvoiceKsefState[]

  @@unique([invoiceId, environment, attemptNumber])
  @@index([companyId, environment, status])
}

model KsefSession {
  id          String          @id @default(cuid())
  companyId   String
  environment KsefEnvironment @default(TEST)
  tokenEnc    String
  tokenIv     String
  expiresAt   DateTime
  lastUsedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, environment])
  @@index([companyId])
}

model InvoiceKsefState {
  id               String            @id @default(cuid())
  invoiceId        String
  environment      KsefEnvironment
  status           InvoiceKsefStatus @default(NOT_SENT)
  ksefReference    String?
  submittedAt      DateTime?
  acceptedAt       DateTime?
  lastSubmissionId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  invoice          Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lastSubmission   KsefSubmission?   @relation(fields: [lastSubmissionId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, environment])
  @@index([environment, status])
  @@index([lastSubmissionId])
}

model FileRecord {
  id                String           @id @default(cuid())
  companyId         String
  invoiceId         String?
  incomingInvoiceId String?
  type              String // outgoing_pdf | outgoing_xml | incoming_scan
  path              String // absolute path on disk
  relativePath      String // relative to STORAGE_BASE_PATH
  mimeType          String
  sizeBytes         Int
  checksum          String? // SHA-256
  storageIdempotencyKey String? @unique
  backedUpAt        DateTime?
  createdAt         DateTime         @default(now())
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  incomingInvoice   IncomingInvoice? @relation(fields: [incomingInvoiceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([invoiceId])
  @@index([incomingInvoiceId])
}

model IncomingInvoice {
  id              String                @id @default(cuid())
  companyId       String
  environment     KsefEnvironment       @default(TEST)
  contractorId    String?
  status          IncomingInvoiceStatus @default(UPLOADED)
  sellerName      String?
  sellerNip       String?
  sellerAddress   String?
  buyerName       String?
  buyerNip        String?
  invoiceNumber   String?
  issueDate       DateTime?
  saleDate        DateTime?
  totalNet        Decimal?              @db.Decimal(15, 2)
  totalVat        Decimal?              @db.Decimal(15, 2)
  totalGross      Decimal?              @db.Decimal(15, 2)
  currency        String?               @default("PLN")
  paymentMethod   String?
  dueDate         DateTime?
  bankAccount     String?
  notes           String?
  lineItemsJson   Json?
  ocrConfidence   Float?
  ocrWarnings     Json?
  ocrModel        String?
  ocrError        String?
  ocrMethod       String?
  ksefEnvironment KsefEnvironment?
  ksefReference   String?
  ksefFetchedAt   DateTime?
  source          String                @default("upload") // "upload" | "ksef"
  confirmedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractor      Contractor?           @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  fileRecords     FileRecord[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, environment, status])
  @@index([companyId, environment, createdAt])
  @@index([companyId, ksefReference])
  @@index([companyId, ksefEnvironment, ksefReference])
  @@unique([companyId, environment, ksefReference])
}

model GoogleDriveCredential {
  id             String    @id @default(cuid())
  companyId      String    @unique
  credentialsEnc String // AES-256-GCM encrypted JSON {access_token, refresh_token, expiry_date}
  credentialsIv  String
  expiresAt      DateTime
  requiresReauthorization Boolean @default(false)
  lastBackupAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model BackupRun {
  id            String    @id @default(cuid())
  provider      String // gdrive | icloud
  companyId     String?
  triggerSource String?
  status        String // success | error
  filesCount    Int       @default(0)
  bytesTotal    BigInt    @default(0)
  errorMessage  String?
  startedAt     DateTime
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([provider])
  @@index([companyId])
}

model CompanyBackupPolicy {
  id                       String                    @id @default(cuid())
  companyId                String
  provider                 CompanyBackupProvider     @default(GOOGLE_DRIVE)
  automaticOnInvoiceIssued Boolean                   @default(false)
  scheduleMode             CompanyBackupScheduleMode @default(MANUAL)
  scheduleHour             Int?
  scheduleMinute           Int?
  scheduleDayOfWeek        Int?
  scheduleTimezone         String                    @default("Europe/Warsaw")
  lastScheduledRunKey      String?
  lastScheduledRunAt       DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([scheduleMode])
}

model UserInvite {
  id         String                @id @default(cuid())
  companyId  String
  email      String
  role       CompanyMembershipRole @default(VIEWER)
  token      String                @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime              @default(now())

  @@index([companyId])
  @@index([token])
}

model ServiceTemplate {
  id              String                  @id @default(cuid())
  companyId       String
  name            String
  unit            String                  @default("szt.")
  vatRate         String                  @default("23")
  description     String?
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractorRates ContractorServiceRate[]

  @@index([companyId, isActive])
}

model ContractorServiceRate {
  id                String          @id @default(cuid())
  contractorId      String
  serviceTemplateId String
  unitNetPrice      Decimal         @db.Decimal(15, 4)
  currency          String          @default("PLN")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  contractor        Contractor      @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  serviceTemplate   ServiceTemplate @relation(fields: [serviceTemplateId], references: [id], onDelete: Cascade)

  @@unique([contractorId, serviceTemplateId])
  @@index([contractorId])
}

model KsefIncomingSync {
  id           String          @id @default(cuid())
  companyId    String
  environment  KsefEnvironment @default(TEST)
  dateFrom     DateTime
  dateTo       DateTime
  createdCount Int             @default(0)
  linkedCount  Int             @default(0)
  skippedCount Int             @default(0)
  errorMessage String?
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, environment])
}
