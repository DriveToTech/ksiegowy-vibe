generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("HOUSEHOLD_DATABASE_URL")
}

enum HouseholdMembershipRole {
  OWNER
  MEMBER
}

enum HouseholdAccountType {
  CURRENT
  SAVINGS
  CREDIT_CARD
  CASH
}

enum HouseholdAccountVisibility {
  SHARED
  PRIVATE
}

enum HouseholdTransactionCategorizationSource {
  MANUAL
  RULE
  IMPORT
}

enum HouseholdCategoryCashFlowTreatment {
  STANDARD
  TRANSFER
}

enum CommitmentType {
  INSURANCE
  LOAN
  SUBSCRIPTION
  UTILITY
  OTHER
}

enum CommitmentBillingFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum CommitmentStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum CategorizationRuleMatchType {
  EXACT
  SUBSTRING
}

enum GoalKind {
  ONE_OFF
  ONGOING
  NO_CEILING
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GoalMovementSource {
  MANUAL
  AUTOMATION
  ROUND_UP
}

enum GoalAutomationRuleType {
  FIXED_ON_DAY
  PERCENT_OF_INCOME_OVER_THRESHOLD
  ROUND_UP
}

enum InvestmentWrapper {
  TAXABLE
  IKE
  IKZE
}

enum InvestmentPositionVisibility {
  SHARED
  PRIVATE
}

enum InvestmentTransactionType {
  BUY
  SELL
  VALUATION_UPDATE
  CONTRIBUTION
}

// ── Tenancy ──────────────────────────────────────────────────────────────────

model Household {
  id                  String                @id @default(cuid())
  name                String
  currency            String                @default("PLN")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  memberships         HouseholdMembership[]
  accounts            HouseholdAccount[]
  categories          HouseholdCategory[]
  transactions        HouseholdTransaction[]
  envelopes           BudgetEnvelope[]
  commitments         Commitment[]
  categorizationRules CategorizationRule[]
  goals               Goal[]
  goalMovements       GoalMovement[]
  goalAutomationRules GoalAutomationRule[]
  investmentPositions InvestmentPosition[]
  investmentTransactions InvestmentTransaction[]
}

// Not a Prisma relation to User — User lives in the business database, so no
// cross-database foreign key is possible. Instead this carries an identity
// snapshot (userEmail, displayName), written at invite/join time and refreshed
// on that member's own next authenticated household request.
model HouseholdMembership {
  id          String                  @id @default(cuid())
  householdId String
  userId      String
  userEmail   String
  displayName String?
  role        HouseholdMembershipRole @default(MEMBER)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  household   Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@unique([householdId, userEmail])
  @@index([userId])
}

// ── Accounts ─────────────────────────────────────────────────────────────────

// balance is intentionally not stored: current balance is computed as
// openingBalance + SUM(HouseholdTransaction.amount) at read time, the same
// single-source-of-truth reasoning as BudgetEnvelope's computed spend.
model HouseholdAccount {
  id                String                     @id @default(cuid())
  householdId       String
  name              String
  type              HouseholdAccountType
  accountNumberMask String?
  visibility        HouseholdAccountVisibility @default(SHARED)
  ownerUserId       String?
  openingBalance    Decimal                    @default(0) @db.Decimal(15, 2)
  creditLimit       Decimal?                   @db.Decimal(15, 2)
  statementDay      Int?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  household         Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions      HouseholdTransaction[]
  commitments       Commitment[]
  goals             Goal[]
  goalFundingAutomationRules GoalAutomationRule[] @relation("GoalAutomationFundingAccount")
  goalTriggerAutomationRules GoalAutomationRule[] @relation("GoalAutomationTriggerAccount")

  @@index([householdId])
  @@index([householdId, visibility])
  @@unique([householdId, id])
}

// ── Categories ───────────────────────────────────────────────────────────────

model HouseholdCategory {
  id               String              @id @default(cuid())
  householdId      String
  name             String
  parentCategoryId String?
  cashFlowTreatment HouseholdCategoryCashFlowTreatment @default(STANDARD)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  household        Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parentCategory   HouseholdCategory?  @relation("HouseholdCategoryHierarchy", fields: [householdId, parentCategoryId], references: [householdId, id], onDelete: Restrict)
  childCategories  HouseholdCategory[] @relation("HouseholdCategoryHierarchy")
  transactions     HouseholdTransaction[]
  envelope         BudgetEnvelope?
  categorizationRules CategorizationRule[]

  @@index([householdId])
  @@index([householdId, parentCategoryId])
  @@unique([householdId, id])
}

// ── Ledger ───────────────────────────────────────────────────────────────────

// Transfers between accounts are two linked rows sharing transferGroupId
// (negative on the source account, positive on the destination) instead of a
// type enum, so every balance/income/spend aggregate keeps falling out of the
// same SUM(amount) with one added predicate (transferGroupId IS NULL).
model HouseholdTransaction {
  id                   String                                    @id @default(cuid())
  householdId          String
  accountId            String
  categoryId           String?
  payee                String
  payerUserId          String?
  bankDescription      String?
  amount               Decimal                                   @db.Decimal(15, 2)
  date                 DateTime                                  @db.Date
  tag                  String?
  note                 String?
  isRecurring          Boolean                                   @default(false)
  commitmentId         String?
  goalMovementId       String?
  categorizationSource HouseholdTransactionCategorizationSource  @default(MANUAL)
  importBatchId        String?
  transferGroupId      String?
  createdAt            DateTime                                  @default(now())
  updatedAt            DateTime                                  @updatedAt
  household            Household                                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account              HouseholdAccount                          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category             HouseholdCategory?                        @relation(fields: [householdId, categoryId], references: [householdId, id], onDelete: Restrict)
  commitment           Commitment?                               @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  goalMovement         GoalMovement?                             @relation(fields: [householdId, goalMovementId], references: [householdId, id], onDelete: Restrict)
  goalSourceMovements  GoalMovement[]                            @relation("GoalMovementSourceTransaction")

  @@unique([commitmentId, date])
  @@unique([householdId, id])
  @@index([householdId, date])
  @@index([householdId, categoryId, date])
  @@index([accountId, date])
  @@index([transferGroupId])
  @@index([goalMovementId])
}

// ── Budget envelopes ─────────────────────────────────────────────────────────

// "Spent this month" is a computed grouped-SUM query at read time (excluding
// transfers), not a denormalized write-time counter.
// ponytail: no per-period limit snapshot, so a limit change applies
// retroactively to past months' displayed progress — add a
// BudgetEnvelopePeriod table if historical-limit auditing becomes a real ask.
model BudgetEnvelope {
  id            String            @id @default(cuid())
  householdId   String
  categoryId    String            @unique
  monthlyLimit  Decimal           @db.Decimal(15, 2)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  household     Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category      HouseholdCategory @relation(fields: [householdId, categoryId], references: [householdId, id], onDelete: Cascade)

  @@unique([householdId, categoryId])
}

// ── Commitments ──────────────────────────────────────────────────────────────

// Single table, nullable type-specific columns — Prisma has no table
// inheritance, and per-type tables would force a UNION for the one
// register/reminder/dashboard query that must span all types.
model Commitment {
  id               String                     @id @default(cuid())
  householdId      String
  accountId        String
  type             CommitmentType
  name             String
  amount           Decimal                    @db.Decimal(15, 2)
  billingFrequency CommitmentBillingFrequency
  nextDueDate      DateTime                   @db.Date
  status           CommitmentStatus           @default(ACTIVE)
  // Standing order/direct debit vs. paid manually by a household member — the
  // due-date-advancement cron only auto-generates a transaction when true.
  isAutomatic      Boolean                    @default(true)

  // Insurance-only
  provider       String?
  policyNumber   String?
  insuredObject  String?
  sumInsured     Decimal? @db.Decimal(15, 2)
  coverBreakdown Json?

  // Loan-only — amortization schedule is computed on read, not stored
  principal         Decimal? @db.Decimal(15, 2)
  outstandingBalance Decimal? @db.Decimal(15, 2)
  interestRate      Decimal? @db.Decimal(5, 4)
  termMonths        Int?

  // Subscription-only — drives the "unused" nudge
  lastUsedAt DateTime?

  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  household    Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account      HouseholdAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transactions HouseholdTransaction[]

  @@index([householdId])
  @@index([householdId, status])
  @@index([householdId, nextDueDate])
}

// ── Categorization rules ─────────────────────────────────────────────────────

// Not auto-created on every recategorization — rule creation is an explicit
// opt-in checkbox on the recategorize action. Precedence: exact match before
// substring, longest substring wins among substring matches, ties broken by
// most recently created rule.
model CategorizationRule {
  id            String                       @id @default(cuid())
  householdId   String
  matchType     CategorizationRuleMatchType
  payeePattern  String
  categoryId    String
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  household     Household                    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category      HouseholdCategory            @relation(fields: [householdId, categoryId], references: [householdId, id], onDelete: Cascade)

  @@index([householdId])
  @@index([householdId, matchType])
}

// ── Savings goals ───────────────────────────────────────────────────────────

model Goal {
  id              String                @id @default(cuid())
  householdId     String
  accountId       String
  name            String
  description     String?
  kind            GoalKind
  status          GoalStatus            @default(ACTIVE)
  targetAmount    Decimal?              @db.Decimal(15, 2)
  currentAmount   Decimal               @default(0) @db.Decimal(15, 2)
  targetDate      DateTime?             @db.Date
  monthlyAmount   Decimal?              @db.Decimal(15, 2)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  household       Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account         HouseholdAccount      @relation(fields: [householdId, accountId], references: [householdId, id], onDelete: Restrict)
  movements       GoalMovement[]
  automationRules GoalAutomationRule[]

  @@index([householdId])
  @@index([householdId, accountId])
  @@unique([householdId, id])
  @@index([accountId])
  @@index([householdId, status])
}

model GoalMovement {
  id                     String                  @id @default(cuid())
  householdId            String
  goalId                 String
  amount                 Decimal                 @db.Decimal(15, 2)
  source                 GoalMovementSource
  effectiveDate          DateTime                @db.Date
  note                   String?
  createdByUserId        String?
  automationRuleId       String?
  sourceTransactionId    String?
  transferGroupId        String                  @unique
  idempotencyKey         String                  @unique
  calculationWindowStart DateTime?               @db.Date
  calculationWindowEnd   DateTime?               @db.Date
  balanceAfter           Decimal                 @db.Decimal(15, 2)
  createdAt              DateTime                @default(now())
  household              Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  goal                   Goal                    @relation(fields: [householdId, goalId], references: [householdId, id], onDelete: Cascade)
  automationRule         GoalAutomationRule?     @relation(fields: [householdId, automationRuleId], references: [householdId, id], onDelete: Restrict)
  sourceTransaction      HouseholdTransaction?   @relation("GoalMovementSourceTransaction", fields: [householdId, sourceTransactionId], references: [householdId, id], onDelete: Restrict)
  transactions           HouseholdTransaction[]

  @@unique([householdId, id])
  @@index([goalId, effectiveDate])
  @@index([householdId, effectiveDate])
  @@index([automationRuleId, sourceTransactionId])
  @@index([sourceTransactionId])
}

model GoalAutomationRule {
  id                    String                   @id @default(cuid())
  householdId           String
  goalId                String
  ruleType              GoalAutomationRuleType
  automationIdentity    String                   @default(cuid())
  fundingAccountId      String
  triggerAccountId      String?
  createdByUserId        String
  startsOn              DateTime                 @db.Date
  isActive               Boolean                  @default(true)
  fixedAmount            Decimal?                 @db.Decimal(15, 2)
  dayOfMonth             Int?
  percentage             Decimal?                 @db.Decimal(5, 2)
  incomeThreshold        Decimal?                 @db.Decimal(15, 2)
  roundUpToAmount        Decimal?                 @db.Decimal(15, 2)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  deletedAt              DateTime?
  roundUpCursorDate      DateTime?                @db.Date
  roundUpCursorId        String?
  household              Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  goal                   Goal                     @relation(fields: [householdId, goalId], references: [householdId, id], onDelete: Cascade)
  fundingAccount         HouseholdAccount         @relation("GoalAutomationFundingAccount", fields: [householdId, fundingAccountId], references: [householdId, id], onDelete: Restrict)
  triggerAccount         HouseholdAccount?        @relation("GoalAutomationTriggerAccount", fields: [householdId, triggerAccountId], references: [householdId, id], onDelete: Restrict)
  movements              GoalMovement[]

  @@unique([householdId, id])
  @@unique([householdId, automationIdentity])
  @@index([householdId])
  @@index([goalId, isActive])
  @@index([fundingAccountId])
  @@index([triggerAccountId])
}

// ── Manual investing ─────────────────────────────────────────────────────────

// A position is a small consistency boundary. Its owner never changes, even
// when the position is shared with the rest of the household.
model InvestmentPosition {
  id                      String                       @id @default(cuid())
  householdId             String
  ownerUserId             String
  wrapper                 InvestmentWrapper
  visibility              InvestmentPositionVisibility @default(PRIVATE)
  instrument              String
  units                   Decimal                      @db.Decimal(20, 8)
  costBasis               Decimal                      @db.Decimal(15, 2)
  currentValue            Decimal?                     @db.Decimal(15, 2)
  targetAllocationPercent Decimal?                     @db.Decimal(5, 2)
  lastValuedAt            DateTime?
  archivedAt              DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  household               Household                    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions            InvestmentTransaction[]

  @@unique([householdId, id])
  @@index([householdId, visibility])
  @@index([householdId, archivedAt])
  @@index([ownerUserId])
}

// This is an append-only journal. Voiding writes audit metadata instead of
// deleting or mutating the original fact; the position projection is rebuilt.
model InvestmentTransaction {
  id             String                    @id @default(cuid())
  householdId    String
  positionId     String
  type           InvestmentTransactionType
  units          Decimal?                  @db.Decimal(20, 8)
  amount         Decimal                   @db.Decimal(15, 2)
  date           DateTime                  @db.Date
  operationId    String
  voidedAt       DateTime?
  voidedByUserId String?
  createdAt      DateTime                  @default(now())
  household      Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  position       InvestmentPosition        @relation(fields: [householdId, positionId], references: [householdId, id], onDelete: Restrict)

  @@unique([householdId, operationId])
  @@index([householdId, positionId, date])
  @@index([positionId, voidedAt])
}
